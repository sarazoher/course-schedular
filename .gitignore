# ------------------------
# Python build artifacts
# ------------------------
__pycache__/
*.py[cod]
*.so
*.pyd
*.pdb

# ------------------------
# Virtual environments
# ------------------------
.venv/
venv/
env/
ENV/

# ------------------------
# Test / lint / type caches
# ------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ------------------------
# Flask / local app state
# ------------------------
# Ignore dev databases
instance/*.db
*.db
*.sqlite
*.sqlite3
*.sqlite3-journal

# Ignore uploaded files
instance/uploads/

# ------------------------
# Environment / secrets
# ------------------------
.env
.env.*
*.env

# ------------------------
# macOS / Windows junk (less repo junk)
# ------------------------
.DS_Store
**/.DS_Store
._*
Icon?
Thumbs.db

# ------------------------
# Editors
# ------------------------
.vscode/
.history/
.idea/

# ------------------------
# Logs / temp files
# ------------------------
*.log
*.swp
*.swo

# ------------------------
# Course catalog data policy
#   - Keeps "small, shareable" metadata tracked
#   - Ignores raw/private Excel inputs
# ------------------------
data_catalog/*.xlsx
data_catalog/*.xls
data_catalog/archive/
data_catalog/**/.DS_Store

# Keep these tracked (they are part of the app’s behavior)
!data_catalog/aliases.csv
!data_catalog/catalog_meta.json
!data_catalog/external_rules.txt
!data_catalog/optional_courses.json

